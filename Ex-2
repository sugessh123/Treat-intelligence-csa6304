
import socket

host = input("Enter target hostname or IP: ")
ports = [22, 80, 443, 3306, 8080]

for port in ports:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(1)
    result = s.connect_ex((host, port))

    if result == 0:
        print(f"Port {port}: OPEN")
    else:
        print(f"Port {port}: CLOSED or FILTERED")

    s.close()
