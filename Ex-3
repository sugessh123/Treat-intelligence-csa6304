policy = input("Enter security policy text: ").lower()

requirements = {
    "Scope": ["scope"],
    "Roles and Responsibilities": ["roles", "responsibilities"],
    "Enforcement": ["enforcement"],
    "Review Cycle": ["review cycle"],
    "Approval Authority": ["approval authority"]
}

for item, words in requirements.items():
    if all(word in policy for word in words):
        print(item + ": Present")
    else:
        print(item + ": Missing")
